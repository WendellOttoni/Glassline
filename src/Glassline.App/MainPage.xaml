<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Glassline.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <Border
            Margin="6"
            Padding="16,10"
            Background="#F20B0D12"
            CornerRadius="28"
            PointerEntered="OnPointerEntered"
            PointerExited="OnPointerExited"
            Tapped="OnSurfaceTapped">
            <Grid>
                <Grid x:Name="CompactContent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="36" Height="36" Background="#FF252A34" CornerRadius="9">
                        <FontIcon Glyph="&#xE8D6;" FontSize="16" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="1">
                        <TextBlock FontWeight="SemiBold" Text="Glassline" />
                        <TextBlock FontSize="11" Foreground="#FF9CA3AF" Text="Nenhuma mídia ativa" />
                    </StackPanel>
                    <FontIcon Grid.Column="2" Glyph="&#xE768;" FontSize="16" />
                </Grid>

                <Grid x:Name="ExpandedContent" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="64" Height="64" Background="#FF252A34" CornerRadius="14">
                            <FontIcon Glyph="&#xE8D6;" FontSize="24" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Glassline" />
                            <TextBlock Foreground="#FF9CA3AF" Text="Aguardando uma sessão de mídia" />
                        </StackPanel>
                    </StackPanel>

                    <ProgressBar Grid.Row="1" Margin="0,14,0,8" Maximum="100" Value="0" />

                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="22">
                        <Button AutomationProperties.Name="Anterior" Background="Transparent">
                            <FontIcon Glyph="&#xE892;" />
                        </Button>
                        <Button AutomationProperties.Name="Reproduzir ou pausar" Background="Transparent">
                            <FontIcon Glyph="&#xE768;" />
                        </Button>
                        <Button AutomationProperties.Name="Próxima" Background="Transparent">
                            <FontIcon Glyph="&#xE893;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
